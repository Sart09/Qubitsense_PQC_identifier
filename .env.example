# Server Configuration
PORT=8000
HOST=0.0.0.0

# Security Configuration
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme_generate_a_random_secret
JWT_ALGORITHM=HS256

# AI Agent Configuration
# Required for the "Qubit" AI assistant. Free key at https://console.groq.com/keys
# Read server-side only (backend/server.py's /api/agent/chat) and never sent
# to the browser. Without this, the app runs normally but Qubit shows an error.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Domain Discovery (optional)
# Raises AlienVault OTX rate limits during subdomain discovery. Free key at
# https://otx.alienvault.com/api. Without this, discovery still runs, just
# slower and more likely to hit 429s on large scans.
ALIENVAULT_API_KEY=

# Supabase Auth (optional — identity backend)
# When these three are blank, the app runs entirely on local bcrypt auth
# (unchanged from today) — registration, login, sessions, and MFA all keep
# working. Once a free project is created at https://supabase.com and these
# are filled in (Project Settings -> API), new registrations are created in
# Supabase as well and login is verified against it, with automatic
# fallback to local auth if Supabase is unreachable. No other config or
# code change is needed to activate it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key — server-side only, never sent to the browser. Required
# only for user creation via the Supabase Admin API.
SUPABASE_SERVICE_ROLE_KEY=

# Admin bootstrap (optional)
# Comma-separated emails that are auto-promoted to role=admin on
# registration. The first account (nick@gmail.com) is always seeded as
# admin on startup regardless of this list — see backend/server.py lifespan.
ADMIN_EMAILS=nick@gmail.com

# Scanner Performance Tuning (all optional — scanner/config.py has sane
# defaults for every one of these; only set if you need to tune for a
# specific environment, e.g. a slower network or a machine with a lower
# fd/socket ceiling).
# TLS_CONCURRENCY=256
# DNS_CONCURRENCY=128
# TLS_CONNECT_TIMEOUT=4
# TLS_HANDSHAKE_TIMEOUT=5
# HOST_DEADLINE=12
# TLS_RETRIES=1
# TLS_RETRY_DELAY=0.4
# SCAN_BUDGET_S=600
# FALLBACK_PORTS=8443,4433,9443
# PORT_RACE_TIMEOUT=6
# PORT_FALLBACK_MAX_HOSTS=1500
# DB_FLUSH_ROWS=200
# DB_FLUSH_SECONDS=1.0
